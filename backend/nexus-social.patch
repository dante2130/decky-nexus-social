 #[cfg(test)]mod tests{
     use super::*;
+    #[test]
+    fn supports_the_two_xbox_party_joinability_values() {
+        assert_eq!(joinability(&json!({})), Ok("inviteOnly"));
+        assert_eq!(joinability(&json!({"joinability":"inviteOnly"})), Ok("inviteOnly"));
+        assert_eq!(joinability(&json!({"joinability":"followedByMembers"})), Ok("followedByMembers"));
+        assert!(joinability(&json!({"joinability":"open"})).is_err());
+        assert!(joinability(&json!({"joinability":null})).is_err());
+    }
     #[test]fn only_fixed_operations_and_safe_party_ids_are_accepted(){
         assert!(validate(&json!({"account":"account","operation":"active"})).is_ok());
         for op in ["https://evil.test/","update-profile","../../me"]{assert!(validate(&json!({"account":"account","operation":op})).is_err());}
