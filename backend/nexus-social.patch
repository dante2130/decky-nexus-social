+fn friend_device(row: &Value) -> Option<&'static str> {
+    if !matches!(row["presenceState"].as_str(), Some("Online" | "Away")) {
+        return None;
+    }
+    let platform = |device: &Value| match device.as_str()? {
+        "Xbox360" | "XboxOne" | "Scarlett" => Some("xbox"),
+        "PC" | "Windows8" | "WindowsOneCore" | "Win32" => Some("pc"),
+        _ => None,
+    };
+    if let Some(details) = row["presenceDetails"].as_array() {
+        let active = |detail: &&Value| detail["State"].as_str() == Some("Active");
+        if let Some(primary) = details.iter().filter(active).find(|detail| detail["IsPrimary"] == true) {
+            return platform(&primary["Device"]);
+        }
+        let mut platforms = details.iter().filter(active).map(|detail| platform(&detail["Device"]));
+        if let Some(first) = platforms.next() {
+            return first.filter(|device| platforms.all(|other| other == Some(*device)));
+        }
+    }
+    let devices = row["presenceDevices"].as_array()?;
+    let mut platforms = devices.iter().map(platform);
+    let device = platforms.next()??;
+    platforms.all(|other| other == Some(device)).then_some(device)
+}
